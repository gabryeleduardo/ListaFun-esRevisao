programa
{
	
	funcao inicio()
	{
		inteiro num1,num2, somacao

		escreva("Digite dois numeros e veja sua soma\n")
		leia(num1)
		leia(num2)
		escreva("\n",somacao = soma(num1,num2))
	}
	funcao inteiro soma(inteiro a, inteiro b){
		retorne a + b
	}
}
